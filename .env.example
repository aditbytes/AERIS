# AERIS — Environment variable names (no values here; set in .env or AWS Secrets Manager)
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to git.

# API keys (names only — never commit real values)
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
DATA_GOV_IN_KEY=

# Data / storage
AERIS_DATA_DIR=data/live
AERIS_STORAGE=local        # local | s3
AERIS_S3_BUCKET=           # aeris-<account>-data (from stack output)
AERIS_S3_PREFIX=gold/

# Agent
AGENT_MODEL_PROVIDER=bedrock   # bedrock (Strands on Amazon Bedrock) | anything else = rules-based plan
AGENT_MODEL_ID=global.anthropic.claude-sonnet-4-6   # Bedrock model or inference-profile id
AGENT_FALLBACK_MODEL_IDS=  # comma-separated ids tried if AGENT_MODEL_ID fails (default: Amazon Nova)
AWS_REGION=ap-south-1

# Web
# API Gateway base URL (set by Aditya after deployment)
API_BASE_URL=

# Deploy (scripts/deploy.sh)
ALERT_EMAIL=               # receives budget alerts
MONTHLY_BUDGET_USD=50
AERIS_STACK=aeris-foundation
