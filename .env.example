# AERIS — Environment variable names (no values here; set in .env or AWS Secrets Manager)
# Copy this file to .env and fill in your real keys.
# NEVER commit .env to git.

# API keys (names only — never commit real values)
FIRMS_MAP_KEY=
OPENAQ_API_KEY=
DATA_GOV_IN_KEY=

# Data / storage
AERIS_DATA_DIR=data/live
AERIS_STORAGE=local        # local | s3
AERIS_S3_BUCKET=

# Agent
AGENT_MODEL_PROVIDER=bedrock   # bedrock | ollama | anthropic
AWS_REGION=ap-south-1

# Web
# API Gateway base URL (set by Aditya after deployment)
API_BASE_URL=
